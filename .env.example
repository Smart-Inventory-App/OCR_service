# Plantilla de configuración. Copiar `.env.example` a `.env` y ajustar lo que haga falta.

# Servidor
HOST=0.0.0.0
PORT=8003
DEBUG=false

# JWT — debe coincidir con el secret del servicio Auth.
# NO commitear el valor real: se define en el `.env` local o en el panel del cloud.
JWT_SECRET=cambiar-por-el-secret-de-auth
JWT_ALGORITHM=HS256

# Servicios del monorepo
STORAGE_SERVICE_URL=http://tpp_storage_service:8000
HTTP_TIMEOUT_SECONDS=30

# URL de Auth tal como la ve el NAVEGADOR (sólo la usa /ocr/playground)
AUTH_PUBLIC_URL=http://localhost:8001

# Motores
# Cada motor es un servicio aparte, con su propio repositorio e imagen.
TESSERACT_SERVICE_URL=http://tpp_ocr_tesseract:8005
# PaddleOCR va replicado: acepta varias URLs separadas por coma y el
# coordinador las reparte por turno.
PADDLEOCR_SERVICE_URL=http://tpp_ocr_paddleocr:8007,http://tpp_ocr_paddleocr_2:8007
# Clave compartida con los motores. Vacía = sin control de acceso (red interna).
# En un despliegue cloud conviene fijarla: ver la sección Railway del README.
ENGINE_API_KEY=
# PaddleOCR tarda segundos por documento: necesita más margen que
# Tesseract.
ENGINE_TIMEOUT_SECONDS=120

# Ancho que se le pide a un motor que prepara su propia entrada
# PaddleOCR).
# El sello de vencimiento necesita más resolución que una etiqueta.
ENGINE_MAX_WIDTH=800
ENGINE_STAMP_MAX_WIDTH=1280

# Motor por defecto: tesseract | paddleocr | hybrid
OCR_ENGINE=hybrid
OCR_LANG=spa

# Redis (cola de trabajos + caché de resultados)
REDIS_URL=redis://redis:6379/0
JOB_TTL_SECONDS=86400
CACHE_TTL_SECONDS=86400
QUEUE_KEY=ocr:queue

# Umbrales de aceptación de la propuesta
FIELD_CONFIDENCE_THRESHOLD=0.85
DOCUMENT_CONFIDENCE_THRESHOLD=0.70

# Modo híbrido: motor principal, de respaldo y umbral que dispara el respaldo
HYBRID_PRIMARY_ENGINE=tesseract
HYBRID_FALLBACK_ENGINE=paddleocr
HYBRID_FALLBACK_THRESHOLD=0.70

# ── Estrategia de intentos (la decide este servicio, no los motores) ──────────
RETRY_ENABLED=true
RETRY_THRESHOLD=0.75
# Búsqueda de orientación en las fotos del sello de vencimiento
ROTATION_SEARCH_ENABLED=true

# Preparación de la imagen para etiquetas y tickets
PREPROCESS_GRAYSCALE=true
PREPROCESS_UPSCALE=true
PREPROCESS_INVERT=true
PREPROCESS_CONTRAST=true
PREPROCESS_DENOISE=false
PREPROCESS_DESKEW=true
PREPROCESS_MIN_WIDTH=1600
PREPROCESS_MAX_WIDTH=3000

# Preparación para el sello de vencimiento (se amplía más)
STAMP_MIN_WIDTH=2400
STAMP_MAX_WIDTH=3600

# Códigos de barras (doc_type=barcode). No necesita búsqueda de orientación ni
# realce de contraste: ZBar resuelve las dos cosas por su cuenta. Lo único que
# mueve la aguja es la resolución, y el enfoque en una banda angosta.
BARCODE_UPSCALE_FACTOR=2
BARCODE_SHARPEN_ENABLED=true
BARCODE_MAX_PIXELS=60000000

# CORS
ALLOWED_ORIGINS_STR=http://localhost:3000,http://localhost:8081,http://localhost:19000
