# Servidor
HOST=
PORT=
DEBUG=

# JWT — debe coincidir con el secret del servicio Auth
JWT_SECRET=
JWT_ALGORITHM=

# Servicios del monorepo
STORAGE_SERVICE_URL=
HTTP_TIMEOUT_SECONDS=

# Redis (cola de trabajos + caché de resultados)
REDIS_URL=
JOB_TTL_SECONDS=
CACHE_TTL_SECONDS=
QUEUE_KEY=

# Motor OCR: tesseract | easyocr | hybrid
OCR_ENGINE=
OCR_LANG=
# Vacío = usar el binario del PATH (en Windows: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# Umbrales de aceptación de la propuesta
FIELD_CONFIDENCE_THRESHOLD=
DOCUMENT_CONFIDENCE_THRESHOLD=

# Modo híbrido: motor de respaldo cuando la confianza no alcanza el umbral
HYBRID_FALLBACK_THRESHOLD=
HYBRID_FALLBACK_ENGINE=

# Preprocesamiento OpenCV (desactivar pasos para comparar en el benchmark)
PREPROCESS_GRAYSCALE=
PREPROCESS_UPSCALE=
PREPROCESS_DENOISE=
PREPROCESS_THRESHOLD=
PREPROCESS_DESKEW=
PREPROCESS_MIN_WIDTH=

# CORS
ALLOWED_ORIGINS_STR=
