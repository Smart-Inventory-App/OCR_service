# Servidor
HOST=
PORT=
DEBUG=

# JWT — debe coincidir con el secret del servicio Auth
JWT_SECRET=
JWT_ALGORITHM=

# Servicios del monorepo
STORAGE_SERVICE_URL=
HTTP_TIMEOUT_SECONDS=

# URL de Auth tal como la ve el NAVEGADOR (sólo la usa /ocr/playground)
AUTH_PUBLIC_URL=

# Motores
# Cada motor es un servicio aparte, con su propio repositorio e imagen.
TESSERACT_SERVICE_URL=
EASYOCR_SERVICE_URL=
# Clave compartida con los motores. Vacía = sin control de acceso (red interna).
ENGINE_API_KEY=
# EasyOCR tarda segundos por documento: necesita más margen que Tesseract.
ENGINE_TIMEOUT_SECONDS=

# Ancho que se le pide a un motor que prepara su propia entrada (EasyOCR).
# El sello de vencimiento necesita más resolución que una etiqueta.
ENGINE_MAX_WIDTH=
ENGINE_STAMP_MAX_WIDTH=

# Motor por defecto: tesseract | easyocr | hybrid
OCR_ENGINE=
OCR_LANG=

# Redis (cola de trabajos + caché de resultados)
REDIS_URL=
JOB_TTL_SECONDS=
CACHE_TTL_SECONDS=
QUEUE_KEY=

# Umbrales de aceptación de la propuesta
FIELD_CONFIDENCE_THRESHOLD=
DOCUMENT_CONFIDENCE_THRESHOLD=

# Modo híbrido: motor principal, de respaldo y umbral que dispara el respaldo
HYBRID_PRIMARY_ENGINE=
HYBRID_FALLBACK_ENGINE=
HYBRID_FALLBACK_THRESHOLD=

# ── Estrategia de intentos (la decide este servicio, no los motores) ──────────
RETRY_ENABLED=
RETRY_THRESHOLD=
# Búsqueda de orientación en las fotos del sello de vencimiento
ROTATION_SEARCH_ENABLED=

# Preparación de la imagen para etiquetas y tickets
PREPROCESS_GRAYSCALE=
PREPROCESS_UPSCALE=
PREPROCESS_INVERT=
PREPROCESS_CONTRAST=
PREPROCESS_DENOISE=
PREPROCESS_DESKEW=
PREPROCESS_MIN_WIDTH=
PREPROCESS_MAX_WIDTH=

# Preparación para el sello de vencimiento (se amplía más)
STAMP_MIN_WIDTH=
STAMP_MAX_WIDTH=

# CORS
ALLOWED_ORIGINS_STR=
